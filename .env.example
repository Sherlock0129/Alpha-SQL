# Project-local settings. Copy to .env.local; shell variables take precedence.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-35b-a3b
PREPROCESS_MODEL=qwen3.5-35b-a3b
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
SQL_GENERATION_SAMPLES=2
SQL_REVISION_SAMPLES=2
SQL_VALIDATION_MAX_TRIES=4
LLM_MAX_REQUESTS=120
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=1
SQL_SELECTION_REPEATS=1

# TypeSafe System One (Jev) is used only by the independent constrained runner.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_REQUEST_TIMEOUT=60
JEV_MAX_RETRIES=1
JEV_SCHEMA_THRESHOLD=0.50
JEV_RERANK_THRESHOLD=0.55
JEV_BEAM_WIDTH=8
JEV_MIN_CONFIDENCE=0.50

# Official DeepEye-SQL launcher (optional overrides).
# Blank values fall back to OPENAI_*/DASHSCOPE_* and the existing embedding config.
DEEPEYE_MODEL=qwen3.5-35b-a3b
DEEPEYE_BASE_URL=
DEEPEYE_API_KEY=
DEEPEYE_EMBEDDING_MODEL=text-embedding-v4
DEEPEYE_EMBEDDING_BASE_URL=
DEEPEYE_EMBEDDING_API_KEY=
